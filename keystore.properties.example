# Copy this file to keystore.properties and fill in the keystore that AppGallery Connect
# holds the SHA-256 fingerprint for. Wear Engine rejects an APK signed with the Android
# debug key, so both debug and release builds are signed with this one.
# keystore.properties is in .gitignore, so nothing here reaches the repository.

# Path to the .jks file, relative to the project root or absolute.
storeFile=wearengine-release.jks
storePassword=
keyAlias=
keyPassword=
