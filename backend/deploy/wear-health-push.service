[Unit]
Description=Wear Health Push
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wear-health-push
ExecStart=/usr/bin/node --env-file=/opt/wear-health-push/.env /opt/wear-health-push/src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
