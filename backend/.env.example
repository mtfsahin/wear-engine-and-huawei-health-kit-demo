HOST=127.0.0.1
PORT=3000
STORE_FILE=data/devices.json

# Health Kit subscription, from the Health Kit service card on HUAWEI Developers
HEALTH_API_HOST=health-api.cloud.huawei.com
HEALTH_SUBSCRIBER_ID=
HEALTH_SUBSCRIBER_SECRET=
HEALTH_CLIENT_ID=
HEALTH_EVENT_TYPE=ACTIVITY_RECORD_EVENT$UPDATE

# Firebase service account json, for phones with Google services
FCM_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Push Kit, from AppGallery Connect
HMS_APP_ID=
HMS_APP_SECRET=
